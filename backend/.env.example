# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_medication
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 短信服务配置（阿里云）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=智能用药
SMS_TEMPLATE_CODE=SMS_123456789

# 推送通知配置（极光推送/个推）
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# OCR服务配置
OCR_API_KEY=
OCR_API_URL=

# 日志配置
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log

# CORS配置
CORS_ORIGIN=*
